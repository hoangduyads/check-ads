# Cấu hình biến môi trường tùy chọn cho Creative Ads CHECK
# (Khuyến nghị: có thể nhập trực tiếp API Key trên giao diện web để lưu tạm trong RAM)

# Gemini API Key từ Google AI Studio (Tùy chọn nếu muốn nạp tự động vào Backend khi khởi động)
# GEMINI_API_KEY=your_gemini_api_key_here

# Cổng Backend (Mặc định: 8000)
# PORT=8000

# Loopback Host an toàn (Mặc định: 127.0.0.1)
# HOST=127.0.0.1
