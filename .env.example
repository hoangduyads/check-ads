# Cấu hình biến môi trường tùy chọn cho Creative Ads CHECK
# (Có thể nạp qua biến môi trường này hoặc nhập trên giao diện web và chọn "Lưu key trên máy này" để lưu an toàn vào cấu hình local .gemini_local_config.json ngoài Git)

# Gemini API Key từ Google AI Studio (Tùy chọn: nạp tự động vào Backend khi khởi động)
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Cổng Backend (Mặc định: 8000)
# PORT=8000

# Loopback Host an toàn (Mặc định: 127.0.0.1)
# HOST=127.0.0.1
